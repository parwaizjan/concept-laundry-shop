---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/inter';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/sora';
import '@fontsource-variable/manrope';
import '@fontsource-variable/noto-sans-sinhala';
import '@fontsource-variable/noto-sans-tamil';
import '../styles/global.css';

import siteConfig from '../../site.config';
import { defaultLocale, enabledLocales, switchLocalePath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = siteConfig.brand.name,
  description = siteConfig.brand.tagline,
  lang = siteConfig.locale.default,
} = Astro.props;

const pageTitle = title;
const siteUrl = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(siteConfig.brand.ogImage, siteUrl);
const alternates = enabledLocales().map((code) => ({
  code,
  href: new URL(switchLocalePath(Astro.url.pathname, code), siteUrl).href,
}));
const defaultHref = new URL(switchLocalePath(Astro.url.pathname, defaultLocale), siteUrl).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!siteConfig.indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-dvh antialiased">
    <slot />
  </body>
</html>
