---
import siteConfig from '../../site.config';
import type { Messages } from '../i18n/utils';
import { telLink } from '../i18n/utils';
import Button from './Button.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
const { contact } = siteConfig;
---

<section id="location" class="section scroll-mt-20 bg-surface-muted">
  <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <SectionHeading title={t.location.title} subtitle={t.location.subtitle} />

      <dl class="mt-8 space-y-6">
        <div class="flex items-start gap-3">
          <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />
          <div>
            <dt class="text-sm font-semibold text-ink">{t.location.addressLabel}</dt>
            <dd class="mt-1 text-sm text-ink-muted">{contact.address}</dd>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />
          <div>
            <dt class="text-sm font-semibold text-ink">{t.location.hoursLabel}</dt>
            <dd class="mt-1 space-y-1">
              {
                t.location.hours.map((row) => (
                  <p class="flex gap-4 text-sm text-ink-muted">
                    <span class="w-40">{row.day}</span>
                    <span class="font-medium text-ink">{row.time}</span>
                  </p>
                ))
              }
            </dd>
          </div>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={contact.mapUrl} variant="primary" target="_blank" rel="noopener">
          <Icon name="map-pin" class="h-4 w-4" />
          {t.actions.directions}
        </Button>
        <Button href={telLink()} variant="secondary">
          <Icon name="phone" class="h-4 w-4" />
          {t.actions.call}
        </Button>
      </div>
    </div>

    <div class="relative overflow-hidden rounded-brand border border-ink/10 bg-surface">
      <div class="relative h-72 w-full bg-gradient-to-br from-accent/40 via-surface-muted to-brand/20 sm:h-96">
        <div
          class="absolute inset-0 opacity-60"
          style="background-image:linear-gradient(var(--ink) 1px, transparent 1px), linear-gradient(90deg, var(--ink) 1px, transparent 1px); background-size:44px 44px; opacity:0.06"
        >
        </div>
        <div class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand text-brand-foreground shadow-lg">
            <Icon name="map-pin" class="h-7 w-7" />
          </span>
          <span class="mt-3 rounded-full bg-surface px-3 py-1 text-xs font-semibold text-ink shadow-sm">
            {siteConfig.brand.name}
          </span>
        </div>
      </div>
      <a
        href={contact.mapUrl}
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 border-t border-ink/10 px-5 py-4 text-sm font-semibold text-brand transition hover:bg-surface-muted"
      >
        <Icon name="map-pin" class="h-4 w-4" />
        {t.actions.directions}
      </a>
    </div>
  </div>
</section>
