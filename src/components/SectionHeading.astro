---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <h2 class="text-3xl font-bold text-ink sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg text-ink-muted">{subtitle}</p>}
</div>
