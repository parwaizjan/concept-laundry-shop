---
import type { Messages } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
---

<section id="faq" class="section scroll-mt-20">
  <div class="container-page">
    <SectionHeading title={t.faq.title} align="center" />

    <div class="mx-auto mt-10 max-w-3xl divide-y divide-ink/10 overflow-hidden rounded-brand border border-ink/10 bg-surface">
      {
        t.faq.items.map((item) => (
          <details class="group px-6 py-5" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
              {item.question}
              <span class="text-brand transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
