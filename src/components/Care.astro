---
import type { Messages } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
---

<section id="care" class="section scroll-mt-20">
  <div class="container-page">
    <SectionHeading title={t.care.title} subtitle={t.care.subtitle} align="center" />

    <p class="mx-auto mt-4 max-w-2xl text-center text-base leading-relaxed text-ink-muted">
      {t.care.intro}
    </p>

    <span class="section-label mt-12 block text-center">{t.care.tipsTitle}</span>

    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.care.tips.map((tip, index) => (
          <article class="rounded-brand border border-ink/10 bg-surface p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand/10 font-display text-sm font-bold text-brand">
              {index + 1}
            </span>
            <h3 class="mt-4 text-base font-bold text-ink">{tip.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{tip.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
