---
import type { Locale } from '../../site.config';
import siteConfig from '../../site.config';
import { localizedPath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import WhatsAppFab from './WhatsAppFab.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  doc: 'privacy' | 'terms';
}

const { locale, doc } = Astro.props;
const t = useTranslations(locale);
const content = t.legal[doc];
const pathname = Astro.url.pathname;
const pageTitle = `${content.title} | ${siteConfig.brand.name}`;
---

<BaseLayout title={pageTitle} description={t.meta.description} lang={locale}>
  <Header locale={locale} t={t} pathname={pathname} />

  <main class="section">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <a
          href={localizedPath('', locale)}
          class="inline-flex items-center gap-2 text-sm font-semibold text-brand transition hover:gap-3"
        >
          <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
          {t.actions.backHome}
        </a>

        <h1 class="mt-6 text-4xl font-bold text-ink">{content.title}</h1>
        <p class="mt-3 text-sm text-ink-muted">{content.updated}</p>

        <div class="mt-10 space-y-8">
          {
            content.sections.map((section) => (
              <section>
                <h2 class="text-xl font-bold text-ink">{section.heading}</h2>
                <p class="mt-3 text-base leading-relaxed text-ink-muted">{section.body}</p>
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} t={t} />
  <WhatsAppFab t={t} />
</BaseLayout>
