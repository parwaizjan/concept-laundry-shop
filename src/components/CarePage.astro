---
import type { Locale } from '../../site.config';
import siteConfig from '../../site.config';
import { localizedPath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import WhatsAppFab from './WhatsAppFab.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
const pageTitle = `${t.care.title} | ${siteConfig.brand.name}`;
---

<BaseLayout title={pageTitle} description={t.care.subtitle} lang={locale}>
  <Header locale={locale} t={t} pathname={pathname} />

  <main class="section">
    <div class="container-page">
      <a
        href={localizedPath('', locale)}
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand transition hover:gap-3"
      >
        <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
        {t.actions.backHome}
      </a>

      <div class="mt-6 max-w-2xl">
        <h1 class="text-4xl font-bold text-ink">{t.care.title}</h1>
        <p class="mt-4 text-lg text-ink-muted">{t.care.intro}</p>
      </div>

      <h2 class="mt-14 text-2xl font-bold text-ink">{t.care.tipsTitle}</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          t.care.tips.map((tip, index) => (
            <article class="rounded-brand border border-ink/10 bg-surface p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand/10 font-display text-sm font-bold text-brand">
                {index + 1}
              </span>
              <h3 class="mt-4 text-base font-bold text-ink">{tip.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{tip.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </main>

  <Footer locale={locale} t={t} />
  <WhatsAppFab t={t} />
</BaseLayout>
