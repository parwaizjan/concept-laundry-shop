---
import siteConfig from '../../site.config';
import type { Messages } from '../i18n/utils';
import { whatsappLink } from '../i18n/utils';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
const wa = whatsappLink(t.contact.whatsappMessage);
const [first, second, third] = t.hero.points;
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-24 -top-24 h-80 w-80 rounded-full bg-accent/30 blur-3xl"></div>
    <div class="absolute -right-16 top-24 h-72 w-72 rounded-full bg-brand/20 blur-3xl"></div>
  </div>

  <div class="container-page grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-2">
    <div>
      <span class="section-label rounded-full bg-brand/10 px-3 py-1">{t.hero.badge}</span>
      <h1 class="mt-5 text-4xl font-bold leading-[1.05] text-ink sm:text-5xl lg:text-6xl">
        {t.hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink-muted">{t.hero.subtitle}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={wa} variant="primary" size="lg" target="_blank" rel="noopener">
          <Icon name="whatsapp" class="h-5 w-5" />
          {t.actions.whatsapp}
        </Button>
        <Button href="#services" variant="secondary" size="lg">
          {t.actions.viewServices}
          <Icon name="arrow-right" class="h-4 w-4" />
        </Button>
      </div>

      <p class="mt-5">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900"
        >
          <Icon name="bolt" class="h-3.5 w-3.5" />
          {t.hero.expressBadge}
        </span>
      </p>
    </div>

    <div class="relative mx-auto grid w-full max-w-md gap-4">
      <div
        class="relative overflow-hidden rounded-brand bg-gradient-to-br from-brand to-brand-strong p-6 text-brand-foreground shadow-xl sm:p-7"
      >
        <Icon
          name="truck"
          class="pointer-events-none absolute -bottom-6 -right-6 h-40 w-40 text-white/10"
        />
        <span class="relative flex h-12 w-12 items-center justify-center rounded-2xl bg-white/15">
          <Icon name="truck" class="h-6 w-6" />
        </span>
        <p class="relative mt-5 font-display text-2xl font-bold">{first}</p>
        <p class="relative mt-1 text-sm opacity-90">{siteConfig.brand.name}</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-brand border border-ink/10 bg-surface p-6 shadow-sm sm:p-7">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand/10 text-brand">
            <Icon name="clock" class="h-6 w-6" />
          </span>
          <p class="mt-5 text-sm font-semibold text-ink">{second}</p>
        </div>
        <div class="rounded-brand border border-ink/10 bg-surface p-6 shadow-sm sm:p-7">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand/10 text-brand">
            <Icon name="sparkles" class="h-6 w-6" />
          </span>
          <p class="mt-5 text-sm font-semibold text-ink">{third}</p>
        </div>
      </div>
    </div>
  </div>
</section>
