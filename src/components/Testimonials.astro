---
import siteConfig from '../../site.config';
import type { Messages } from '../i18n/utils';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
---

<section id="reviews" class="section scroll-mt-20 bg-surface-muted">
  <div class="container-page">
    <SectionHeading title={t.testimonials.title} align="center" />

    <div class="mt-6 flex justify-center">
      <a
        href={siteConfig.contact.reviewsUrl}
        target="_blank"
        rel="noopener"
        aria-label={t.testimonials.googleCta}
        class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-surface px-4 py-2 text-sm font-semibold text-ink transition hover:bg-surface-muted"
      >
        <Icon name="star" class="h-4 w-4 text-amber-500" />
        {t.testimonials.googleBadge}
        <Icon name="arrow-right" class="h-4 w-4 text-ink-muted" />
      </a>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        t.testimonials.items.map((item) => (
          <figure class="flex h-full flex-col rounded-brand border border-ink/10 bg-surface p-7">
            <div class="flex gap-0.5 text-amber-500">
              {[0, 1, 2, 3, 4].map(() => (
                <Icon name="star" class="h-4 w-4" />
              ))}
            </div>
            <blockquote class="mt-5 flex-1 text-sm leading-relaxed text-ink-muted">
              “{item.quote}”
            </blockquote>
            <figcaption class="mt-6">
              <p class="font-semibold text-ink">{item.name}</p>
              <p class="text-xs text-ink-muted">{item.location}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
