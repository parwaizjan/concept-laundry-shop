---
import type { Locale } from '../../site.config';
import siteConfig from '../../site.config';
import type { Messages } from '../i18n/utils';
import { localizedPath, navSections, whatsappLink } from '../i18n/utils';
import Button from './Button.astro';
import Icon from './Icon.astro';
import LangToggle from './LangToggle.astro';

interface Props {
  locale: Locale;
  t: Messages;
  pathname: string;
}

const { locale, t, pathname } = Astro.props;
const homeHref = localizedPath('', locale);
const visibleNav = navSections.filter((s) => siteConfig.sections[s.configKey]);
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-surface/85 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-2.5">
      <img
        src={siteConfig.brand.logo}
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 rounded-xl"
      />
      <span class="font-display text-lg font-bold tracking-tight text-ink">
        {siteConfig.brand.name}
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        visibleNav.map((section) => (
          <a
            href={`#${section.id}`}
            class="text-sm font-medium text-ink-muted transition hover:text-ink"
          >
            {t.nav[section.key]}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangToggle locale={locale} pathname={pathname} />
      <Button
        href={whatsappLink(t.contact.whatsappMessage)}
        variant="whatsapp"
        class="hidden sm:inline-flex"
        target="_blank"
        rel="noopener"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        <span>{t.actions.whatsapp}</span>
      </Button>
    </div>
  </div>
</header>
